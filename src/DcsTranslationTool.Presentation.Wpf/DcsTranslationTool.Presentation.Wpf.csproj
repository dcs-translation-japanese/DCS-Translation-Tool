<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <NeutralLanguage>ja-JP</NeutralLanguage>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
        <Title>DCS Translation Tool</Title>
        <Product>DcsTranslationTool</Product>
    </PropertyGroup>

    <PropertyGroup>
        <Version>2.1.0</Version> <!-- x-release-please-version -->
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>$(Version).0</FileVersion>
        <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Caliburn.Micro" Version="5.0.258" />
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
        <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
        <PackageReference Include="MoonSharp" Version="2.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DcsTranslationTool.Application\DcsTranslationTool.Application.csproj" />
        <ProjectReference Include="..\DcsTranslationTool.Composition\DcsTranslationTool.Composition.csproj" />
        <ProjectReference Include="..\DcsTranslationTool.Resources\DcsTranslationTool.Resources.csproj" />
        <ProjectReference Include="..\DcsTranslationTool.Shared\DcsTranslationTool.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Assets\Fonts\ZenKakuGothicNew-Regular.ttf" />
        <Resource Include="Assets\Fonts\ZenKakuGothicNew-Medium.ttf" />
        <Resource Include="Assets\Fonts\ZenKakuGothicNew-Bold.ttf" />
    </ItemGroup>

    <ItemGroup>
        <None Update="App.xaml">
            <Generator>MSBuild:Compile</Generator>
        </None>
    </ItemGroup>

    <!-- self-contained publishのapphostからlib配下のアプリ本体を起動する。 -->
    <Target Name="CreatePublishAppHostForLib"
            BeforeTargets="ComputeResolvedFilesToPublishList"
            DependsOnTargets="_CreateAppHost;_GetAppHostPaths;_GetAppHostCreationConfiguration"
            Condition="'$(_IsPublishing)' == 'true' and '$(SelfContained)' == 'true' and '$(PublishSingleFile)' != 'true' and '$(UseAppHost)' == 'true' and Exists('$(AppHostSourcePath)')">
        <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                       AppHostDestinationPath="$(AppHostIntermediatePath)"
                       AppBinaryName="lib\$(AssemblyName)$(TargetExt)"
                       IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                       WindowsGraphicalUserInterface="$(_UseWindowsGraphicalUserInterface)"
                       Retries="$(CopyRetryCount)"
                       RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
                       EnableMacOSCodeSign="$(_EnableMacOSCodeSign)"
                       DisableCetCompat="$(_DisableCetCompat)" />
    </Target>

    <!-- apphost以外の実行用ファイルをlib配下へ集約する。 -->
    <Target Name="MovePublishDependenciesToLib"
            AfterTargets="ComputeFilesToPublish"
            BeforeTargets="_ComputeResolvedFilesToPublishTypes"
            Condition="'$(_IsPublishing)' == 'true' and '$(SelfContained)' == 'true' and '$(PublishSingleFile)' != 'true'">
        <ItemGroup>
            <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                                   Condition="'%(ResolvedFileToPublish.RelativePath)' != '$(AssemblyName)$(_NativeExecutableExtension)'">
                <RelativePath>lib\%(ResolvedFileToPublish.RelativePath)</RelativePath>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

    <Target Name="RenamePublishOutput" AfterTargets="Publish">
        <PropertyGroup>
            <_PublishSourceExe>$(PublishDir)$(AssemblyName).exe</_PublishSourceExe>
            <_PublishTargetExe>$(PublishDir)DCS-Translation-Tool.exe</_PublishTargetExe>
        </PropertyGroup>
        <Delete Files="$(_PublishTargetExe)" Condition="Exists('$(_PublishTargetExe)')" />
        <Move SourceFiles="$(_PublishSourceExe)" DestinationFiles="$(_PublishTargetExe)" Condition="Exists('$(_PublishSourceExe)')" />
    </Target>

</Project>
