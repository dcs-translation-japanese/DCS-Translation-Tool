<Window x:Class="DcsTranslationTool.Presentation.Wpf.Shell.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resx="clr-namespace:DcsTranslationTool.Resources;assembly=DcsTranslationTool.Resources"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:coach="clr-namespace:DcsTranslationTool.Presentation.Wpf.Features.CoachMarks"
        mc:Ignorable="d"
        AutomationProperties.AutomationId="MainWindow"
        Width="{Binding ShellWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Height="{Binding ShellHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        d:Height="450" d:Width="800">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="CoachMarkVisibility" />
        <Style x:Key="UpdateSnackbarActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="AutomationProperties.AutomationId" Value="UpdateSnackbarAction" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="30"
            ResizeBorderThickness="8"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

        <md:DialogHost Identifier="RootDialogHost"
                       AutomationProperties.AutomationId="RootDialogHost">
        <Grid x:Name="RootLayout"
              AutomationProperties.AutomationId="MainWindowRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Titlebar -->
            <Grid Height="30" Background="{StaticResource MaterialDesign.Brush.Primary}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left -->
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" >
                    <Button Content="{md:PackIcon Kind=ArrowLeft}"
                            Style="{StaticResource NavigationButtonStyle}"
                            IsEnabled="{Binding CanGoBack}"
                            coach:CoachMarkHighlight.TargetId="GoBack"
                            cal:Message.Attach="GoBack()" />
                    <Button Content="{md:PackIcon Kind=ArrowRight}"
                            Style="{StaticResource NavigationButtonStyle}"
                            IsEnabled="{Binding CanGoForward}"
                            cal:Message.Attach="GoForward()" />
                </StackPanel>

                <!-- Center -->
                <Grid Grid.Column="1" Margin="{StaticResource MediumXMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static resx:Strings_Shared.AppDisplayName}"
                               Grid.Row="1"
                               Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
                               Foreground="{StaticResource MaterialDesign.Brush.Background}" />
                </Grid>

                <!-- Right -->
                <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" >
                    <Button Content="{md:PackIcon Kind=Git}"
                                ToolTip="ブラウザで翻訳リポジトリーを開く"
                                cal:Message.Attach="BrowseTranslationRepository()" />

                    <Button Content="{md:PackIcon Kind=Cog}"
                                coach:CoachMarkHighlight.TargetId="OpenSettings"
                                AutomationProperties.AutomationId="OpenSettings"
                                AutomationProperties.Name="{x:Static resx:Strings_Settings.Title}"
                                ToolTip="{x:Static resx:Strings_Settings.Title}"
                                cal:Message.Attach="NavToSettings()" />

                    <Button x:Name="CloseWindowButton" Content="{md:PackIcon Kind=Close}"
                            Height="30"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseWindowButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Contents -->
            <AdornerDecorator Grid.Row="1" ClipToBounds="True">
            <Frame x:Name="RootFrame"
                   Margin="{StaticResource MediumMargin}"
                   NavigationUIVisibility="Hidden"
                   Focusable="False"
                   Navigated="RootFrame_Navigated" />
            </AdornerDecorator>

            <!-- Snackbar -->
            <md:Snackbar x:Name="UpdateSnackbar"
                         Grid.Row="1"
                         AutomationProperties.AutomationId="UpdateSnackbar"
                         ActionButtonStyle="{StaticResource UpdateSnackbarActionButtonStyle}"
                         MessageQueue="{Binding MessageQueue}"
                         Style="{DynamicResource SnackbarStyle}" />

            <coach:CoachMarkOverlay x:Name="CoachOverlay" Grid.RowSpan="2" Panel.ZIndex="100"
                                    Target="{Binding CoachMarkTarget}"
                                    CloseButton="{Binding ElementName=CloseWindowButton}"
                                    Visibility="{Binding CoachMarks.IsActive, Converter={StaticResource CoachMarkVisibility}}"
                                    WindowChrome.IsHitTestVisibleInChrome="False">
                <Grid WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 影を本文と分離し、文字を中間画像として描画させない。 -->
                    <Border CornerRadius="12" IsHitTestVisible="False"
                            Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" />
                        </Border.Effect>
                    </Border>
                    <Border Width="Auto" Padding="24" CornerRadius="12"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="{DynamicResource MaterialDesign.Brush.Background}"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}" BorderThickness="1"
                            AutomationProperties.AutomationId="CoachMarkPanel"
                            AutomationProperties.Name="{Binding CoachMarkTitle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="{Binding CoachMarkTitle}" Margin="0,0,28,0"
                                           Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <md:PackIcon Kind="DragVertical" Width="20" Height="20"
                                             HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.54" />
                                <Thumb Background="Transparent" Cursor="SizeAll" Focusable="False"
                                       DragDelta="CoachMarkDialog_DragDelta"
                                       AutomationProperties.AutomationId="CoachMarkDialogDragHandle">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding CoachMarkDescription}" TextWrapping="Wrap" LineHeight="24" />
                                    <TextBlock Text="{Binding CoachMarks.ErrorMessage}" TextWrapping="Wrap" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                               AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </ScrollViewer>
                            <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                                <Button Content="{x:Static resx:Strings_CoachMarks.SkipButtonText}" Margin="0,4,8,0"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        cal:Message.Attach="SkipCoachMark()"
                                        Visibility="{Binding CoachMarks.CanSkip, Converter={StaticResource CoachMarkVisibility}}"
                                        AutomationProperties.AutomationId="SkipCoachMark" />
                                <Button Content="{Binding CoachMarks.NextButtonText}" Margin="0,4,0,0"
                                        IsEnabled="{Binding CanNextCoachMark}"
                                        cal:Message.Attach="NextCoachMark()"
                                        AutomationProperties.AutomationId="NextCoachMark" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </coach:CoachMarkOverlay>
        </Grid>
    </md:DialogHost>
</Window>
